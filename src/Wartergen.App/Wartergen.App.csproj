<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Content Include="Wartergen.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wartergen.Wc3Terrain\Wartergen.Wc3Terrain.csproj" />
    <ProjectReference Include="..\Wartergen.Bmp\Wartergen.Bmp.csproj" />
    <ProjectReference Include="..\Wartergen.Mpq\Wartergen.Mpq.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Wartergen.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- ExcludeFromSingleFile keeps this as a loose file next to the exe on publish,
         instead of getting bundled/extracted-to-temp, since MpqEditorService launches
         it as a subprocess relative to AppContext.BaseDirectory. -->
    <None Include="..\..\MPQEditor\MPQEditor.exe" Link="MPQEditor\MPQEditor.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- DebugType=none in the publish profile only suppresses this project's own .pdb;
       referenced projects' .pdb files still land in the publish output because pubxml
       properties don't flow through ProjectReferences. Strip them here instead. -->
  <Target Name="RemovePdbsFromPublishDir" AfterTargets="Publish">
    <ItemGroup>
      <PdbToRemove Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(PdbToRemove)" />
  </Target>

</Project>
