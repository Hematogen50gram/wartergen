<Window x:Class="Wartergen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Wartergen.App.ViewModels"
        xmlns:models="clr-namespace:Wartergen.App.Models"
        mc:Ignorable="d"
        Title="Wartergen" Height="800" Width="1250">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type models:JsonTreeNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding DisplayText}" />
        </HierarchicalDataTemplate>
        <Style TargetType="TreeViewItem">
            <EventSetter Event="Expanded" Handler="TreeViewItem_Expanded" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <TabControl Margin="12">
        <TabItem Header="Draw Terrain">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="360" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Map file (.w3x/.w3m):"
                               VerticalAlignment="Center" Margin="0,0,8,8" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,8,8" VerticalContentAlignment="Center"
                             Text="{Binding MapFilePath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Padding="8,2" Margin="0,0,0,8"
                            Command="{Binding BrowseMapCommand}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Terrain image (.bmp):"
                               VerticalAlignment="Center" Margin="0,0,8,8" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,8" VerticalContentAlignment="Center"
                             Text="{Binding BmpFilePath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Padding="8,2" Margin="0,0,0,8"
                            Command="{Binding BrowseBmpCommand}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Cliff image (.bmp, optional):"
                               VerticalAlignment="Center" Margin="0,0,8,8" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,8,8" VerticalContentAlignment="Center"
                             Text="{Binding CliffBmpFilePath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Padding="8,2" Margin="0,0,0,8"
                            Command="{Binding BrowseCliffBmpCommand}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Water image (.png, optional):"
                               VerticalAlignment="Center" Margin="0,0,8,8" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,8,8" VerticalContentAlignment="Center"
                             Text="{Binding WaterPngFilePath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Row="3" Grid.Column="2" Content="Browse..." Padding="8,2" Margin="0,0,0,8"
                            Command="{Binding BrowseWaterPngCommand}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Heights image (.png, optional):"
                               VerticalAlignment="Center" Margin="0,0,8,8" />
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,8,8" VerticalContentAlignment="Center"
                             Text="{Binding HeightsPngFilePath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Row="4" Grid.Column="2" Content="Browse..." Padding="8,2" Margin="0,0,0,8"
                            Command="{Binding BrowseHeightsPngCommand}" />

                    <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                                HorizontalAlignment="Left" Margin="0,4,0,8">
                        <Button Content="Draw Terrain" MinWidth="140" Padding="8,6"
                                Command="{Binding DrawTerrainCommand}" />
                        <TextBlock Text="{Binding DrawTerrainStatusMessage}" Foreground="{Binding DrawTerrainStatusBrush}"
                                   VerticalAlignment="Center" FontWeight="Bold" Margin="12,0,0,0" />
                    </StackPanel>

                    <ProgressBar Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Height="6" Margin="0,0,0,8"
                                 IsIndeterminate="{Binding IsBusy}" />
                </Grid>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="BMP Preview" FontWeight="Bold" Margin="0,0,0,4" />

                    <Grid Width="320" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Zoom:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider Grid.Column="1" Minimum="100" Maximum="500" TickFrequency="50"
                                VerticalAlignment="Center"
                                Value="{Binding ZoomPercent, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="40"
                                   Text="{Binding ZoomPercent, StringFormat={}{0:0}%}" />
                    </Grid>

                    <Grid Width="320" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Cliff opacity:" VerticalAlignment="Center" Margin="0,0,6,0"
                                  IsChecked="{Binding CliffEnabled}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="10"
                                VerticalAlignment="Center" IsEnabled="{Binding CliffEnabled}"
                                Value="{Binding CliffOpacityPercent, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="40"
                                   Text="{Binding CliffOpacityPercent, StringFormat={}{0:0}%}" />
                    </Grid>

                    <Grid Width="320" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Water opacity:" VerticalAlignment="Center" Margin="0,0,6,0"
                                  IsChecked="{Binding WaterEnabled}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="10"
                                VerticalAlignment="Center" IsEnabled="{Binding WaterEnabled}"
                                Value="{Binding WaterOpacityPercent, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="40"
                                   Text="{Binding WaterOpacityPercent, StringFormat={}{0:0}%}" />
                    </Grid>

                    <Grid Width="320" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Heights opacity:" VerticalAlignment="Center" Margin="0,0,6,0"
                                  IsChecked="{Binding HeightsEnabled}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="10"
                                VerticalAlignment="Center" IsEnabled="{Binding HeightsEnabled}"
                                Value="{Binding HeightsOpacityPercent, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="40"
                                   Text="{Binding HeightsOpacityPercent, StringFormat={}{0:0}%}" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,16,0">
                            <CheckBox Content="Show crosshair" IsChecked="{Binding ShowCrosshair}" Margin="0,0,0,4" />
                            <CheckBox Content="Show playable border" IsChecked="{Binding ShowPlayableBorder}" Margin="0,0,0,4" />
                        </StackPanel>

                        <GroupBox Grid.Column="1" Header="Color Legends" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Heights color reference:" FontSize="10" FontWeight="Bold" Margin="0,0,0,2" />
                                    <ItemsControl ItemsSource="{Binding HeightsColorLegend}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:HeightsColorLegendEntry}">
                                                <StackPanel Margin="0,0,10,0" HorizontalAlignment="Center">
                                                    <Rectangle Width="24" Height="14" Fill="{Binding Brush}"
                                                               Stroke="Gray" StrokeThickness="0.5" ToolTip="{Binding Hex}" />
                                                    <TextBlock Text="{Binding Label}" FontSize="8" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding Height}" FontSize="8" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Cliff color codes:" FontSize="10" FontWeight="Bold" Margin="0,0,0,2" />

                                    <TextBlock Text="Cliff type #1 (16):" FontSize="9" Margin="0,0,0,1" />
                                    <ItemsControl ItemsSource="{Binding CliffColorLegend}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:CliffColorLegendEntry}">
                                                <StackPanel Margin="0,0,2,0" HorizontalAlignment="Center">
                                                    <Rectangle Width="16" Height="14" Fill="{Binding BrightBrush}"
                                                               Stroke="Gray" StrokeThickness="0.5"
                                                               ToolTip="{Binding BrightHex}" />
                                                    <TextBlock Text="{Binding Height}" FontSize="8" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Cliff type #2 (0):" FontSize="9" Margin="0,4,0,1" />
                                    <ItemsControl ItemsSource="{Binding CliffColorLegend}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:CliffColorLegendEntry}">
                                                <StackPanel Margin="0,0,2,0" HorizontalAlignment="Center">
                                                    <Rectangle Width="16" Height="14" Fill="{Binding DarkBrush}"
                                                               Stroke="Gray" StrokeThickness="0.5"
                                                               ToolTip="{Binding DarkHex}" />
                                                    <TextBlock Text="{Binding Height}" FontSize="8" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <Border Width="600" Height="600" BorderBrush="Gray" BorderThickness="1" Background="Black">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}">
                                <Image Source="{Binding BmpPreviewSource}"
                                       Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}"
                                       Stretch="Fill" SnapsToDevicePixels="True"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                <Image Source="{Binding CliffBmpPreviewSource}"
                                       Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}"
                                       Stretch="Fill" SnapsToDevicePixels="True" IsHitTestVisible="False"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       Opacity="{Binding CliffOpacityFraction}" />
                                <Image Source="{Binding WaterBmpPreviewSource}"
                                       Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}"
                                       Stretch="Fill" SnapsToDevicePixels="True" IsHitTestVisible="False"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       Opacity="{Binding WaterOpacityFraction}" />
                                <Image Source="{Binding HeightsBmpPreviewSource}"
                                       Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}"
                                       Stretch="Fill" SnapsToDevicePixels="True" IsHitTestVisible="False"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       Opacity="{Binding HeightsOpacityFraction}" />
                                <Canvas Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}"
                                        IsHitTestVisible="False">
                                    <Rectangle Canvas.Left="{Binding BorderLeft}" Canvas.Top="{Binding BorderTop}"
                                               Width="{Binding BorderWidth}" Height="{Binding BorderHeight}"
                                               Stroke="Red" StrokeThickness="1"
											   Visibility="{Binding ShowPlayableBorder, Converter={StaticResource BoolToVisibility}}"/>
                                    <Line X1="0" Y1="{Binding CrosshairY}"
                                          X2="{Binding PreviewWidth}" Y2="{Binding CrosshairY}"
                                          Stroke="Yellow" StrokeThickness="1"
                                          Visibility="{Binding ShowCrosshair, Converter={StaticResource BoolToVisibility}}" />
                                    <Line X1="{Binding CrosshairX}" Y1="0"
                                          X2="{Binding CrosshairX}" Y2="{Binding PreviewHeight}"
                                          Stroke="Yellow" StrokeThickness="2"
                                          Visibility="{Binding ShowCrosshair, Converter={StaticResource BoolToVisibility}}" />
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Text="{Binding PreviewError}" Foreground="Tomato" TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <TextBlock Text="{Binding CliffPreviewError}" Foreground="Tomato" TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding WaterPreviewError}" Foreground="Tomato" TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding HeightsPreviewError}" Foreground="Tomato" TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Header="Log">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Output Log" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Clear" Padding="8,2" Command="{Binding ClearLogCommand}" />
                </Grid>
                <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
                    <ListBox x:Name="LogListBox" ItemsSource="{Binding LogEntries}" />
                </Border>
            </Grid>
        </TabItem>
        <TabItem Header="View Terrain Data">
            <Grid Margin="12">
                <Grid.DataContext>
                    <vm:TerrainDataViewModel />
                </Grid.DataContext>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Map file (.w3x/.w3m):"
                           VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,8,8" VerticalContentAlignment="Center"
                         IsReadOnly="True" Text="{Binding MapFilePath, Mode=OneWay}" />
                <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Padding="8,2" Margin="0,0,0,8"
                        Command="{Binding BrowseCommand}" />

                <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="6" Margin="0,0,0,8"
                             IsIndeterminate="{Binding IsBusy}" />

                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="All Terrain Data" FontWeight="Bold" Margin="0,0,0,4" />
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="1">
                        <TreeView x:Name="JsonTreeView" ItemsSource="{Binding RootNodes}"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling" />
                    </Border>

                    <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                  Width="6" HorizontalAlignment="Stretch" Background="LightGray" />

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Meaningful Data (values differing from the majority)"
                               FontWeight="Bold" Margin="0,0,0,4" />
                    <Border Grid.Row="1" Grid.Column="2" BorderBrush="Gray" BorderThickness="1">
                        <TreeView x:Name="MeaningfulTreeView" ItemsSource="{Binding MeaningfulNodes}"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling" />
                    </Border>
                </Grid>

                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0"
                           Text="{Binding StatusMessage}" Foreground="Firebrick" TextWrapping="Wrap" />
            </Grid>
        </TabItem>
    </TabControl>
</Window>
